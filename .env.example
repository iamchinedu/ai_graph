# Copy to .env and fill in. .env is gitignored.
LLM_PROVIDER=gemini
# Gemini: get a key at https://aistudio.google.com/apikey, then replace the placeholder below.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_WRITER_MODEL=gemini-2.5-flash
# OpenAI (set LLM_PROVIDER=openai to use): https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WRITER_MODEL=gpt-4o-mini
# Optional: point the SDK and backend at a different data folder
# DEPMAP_DATA_DIR=./data
